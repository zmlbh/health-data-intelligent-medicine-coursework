               <rdf:li rdf:parseType="Resource">
                  <pdfaSchema:namespaceURI>http://prismstandard.org/namespaces/basic/2.0/</pdfaSchema:namespaceURI>
                  <pdfaSchema:prefix>prism</pdfaSchema:prefix>
